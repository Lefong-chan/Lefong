# Same Firebase Admin SDK credentials already configured on Vercel for
# the main app (Vercel dashboard -> Project Settings -> Environment
# Variables) - copy the same values here so this bot writes into the same
# database the site reads from.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the \n escape sequences exactly as they appear in the Vercel value
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# How many hours to sleep between batches when run with --loop (default 6)
SCRAPER_INTERVAL_HOURS=6

# 1688 only tolerates a handful of requests per run before throwing up a
# CAPTCHA wall - these keep each run small enough to (hopefully) finish
# before that happens. Raise them only if a run is consistently finishing
# its whole batch without ever seeing "FAILED (1688 blocked...)".
SCRAPER_BATCH_SIZE=3
SCRAPER_DETAILS_PER_KEYWORD=2
