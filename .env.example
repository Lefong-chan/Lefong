# ----- Firebase (client SDK, exposed to browser via Vite) -----
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_ADMIN_EMAIL=fongchaneric1@gmail.com

# ----- Firebase Admin SDK (server-only, used by /api functions) -----
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the \n escape sequences when pasting the private key into Vercel env vars
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# ----- Product data -----
# No API key needed here - product data comes from either the scraper bot
# (scraper/, see its README) or the bookmarklet (bookmarklet/, see its
# README) writing into the same Firebase database via the FIREBASE_*
# credentials above.

# Shared secret the bookmarklet (bookmarklet/extract.js) sends as the
# X-Ingest-Secret header when POSTing to /api/ingest - pick any random
# string, set it here and in the bookmarklet's CONFIG.secret. Leaving
# this unset disables the check entirely (anyone could POST fake product
# data), so set it before publishing the site.
INGEST_SECRET=pick-a-random-string

# ----- Admin -----
ADMIN_EMAIL=fongchaneric1@gmail.com
