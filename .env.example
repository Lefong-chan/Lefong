# ----- Firebase (client SDK, exposed to browser via Vite) -----
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_ADMIN_EMAIL=fongchaneric1@gmail.com

# ----- Firebase Admin SDK (server-only, used by /api functions) -----
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the \n escape sequences when pasting the private key into Vercel env vars
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# ----- Product data (CJ Dropshipping API v2) -----
# NEVER expose these to the browser - they are only read inside /api functions
CJ_API_KEY=your-cj-dropshipping-api-key
# The account email used to sign up for the CJ API key - required to log in
# and get an access token. Falls back to ADMIN_EMAIL if not set.
CJ_API_EMAIL=fongchaneric1@gmail.com
CJ_API_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1

# ----- Admin -----
ADMIN_EMAIL=fongchaneric1@gmail.com
